{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/session_start_wakeup.py",
            "timeout": 45
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/universal-prompt-classifier.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/sol_advisor_prompt_state.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/user_prompt_capture.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/user_prompt_improve.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/continuity_prompt_context.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/pre_tool_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/subagent_routing_pretool_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/sol_advisor_pretool_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/post_tool_dispatch.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/sol_advisor_subagent_context.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/sol_advisor_subagent_stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/anti-rationalization-stop.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/ralph-stop-quality-gate.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/file_line_guard.py --event Stop",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/stop_route_decision_warn.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/implementation_notes_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/sol_advisor_stop_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/stop_persist_memory.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/stop_memory_promotion_review.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
