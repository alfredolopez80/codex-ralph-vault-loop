{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|apply_patch|Edit|Write|Agent|spawn_agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/security_pre_tool_dispatch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
